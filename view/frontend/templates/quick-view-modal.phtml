<script>
function quickViewModal() {
    return {
        show: false, loading: false, error: null, product: null,
        mainImage: '', qty: 1, addingToCart: false, cartSuccess: false, cartError: '', lastFocus: null,
        openModal(productId) {
            this.show = true; this.loading = true; this.error = null;
            this.product = null; this.qty = 1; this.cartSuccess = false; this.cartError = '';
            this.lastFocus = document.activeElement;
            this.$nextTick(() => { if (this.$refs.qvClose) this.$refs.qvClose.focus({ preventScroll: true }); });
            document.body.style.overflow = 'hidden';
            document.documentElement.classList.add('panth-overlay-open');
            fetch('<?= $escaper->escapeJs($quickViewUrl) ?>?id=' + encodeURIComponent(productId), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => r.json())
                .then(data => {
                    if (data.success && data.product) { this.product = data.product; this.mainImage = data.product.images?.[0]?.url || ''; }
                    else { this.error = data.message || '<?= $escaper->escapeJs(__('Product not found.')) ?>'; }
                })
                .catch(() => this.error = '<?= $escaper->escapeJs(__('Failed to load product.')) ?>')
                .finally(() => this.loading = false);
        },
        closeModal() {
            this.show = false; document.body.style.overflow = ''; document.documentElement.classList.remove('panth-overlay-open');
            if (this.lastFocus && typeof this.lastFocus.focus === 'function') this.lastFocus.focus({ preventScroll: true });
            this.lastFocus = null;
        },
        trapFocus(e) {
            const items = [...this.$refs.qvDialog.querySelectorAll('button:not([disabled]), a[href], input')].filter(el => el.offsetParent !== null);
            if (!items.length) return;
            const first = items[0], last = items[items.length - 1];
            if (e.shiftKey && (document.activeElement === first || document.activeElement === this.$refs.qvDialog)) { e.preventDefault(); last.focus(); }
            else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        },
        async addToCart() {
            this.addingToCart = true;
            this.cartError = '';
            try {
                const fd = new FormData();
                fd.append('product', this.product.id);
                fd.append('qty', this.qty);
                fd.append('form_key', this.product.form_key);
                const r = await fetch('<?= $escaper->escapeJs($cartAddUrl) ?>', { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                let data = {};
                try { data = await r.json(); } catch (e) { data = {}; }
                const rejected = !r.ok || (data && typeof data.backUrl === 'string' && data.backUrl.indexOf('/checkout/cart') === -1);
                if (!rejected) {
                    this.cartSuccess = true;
                    window.dispatchEvent(new CustomEvent('reload-customer-section-data'));
                    setTimeout(() => this.closeModal(), 1200);
                } else {
                    this.cartError = await this.loadCartError();
                }
            } catch (e) {
                this.cartError = '<?= $escaper->escapeJs(__('This product could not be added to the cart.')) ?>';
            } finally {
                this.addingToCart = false;
            }
        },
        async loadCartError() {
            const fallback = '<?= $escaper->escapeJs(__('This product could not be added to the cart.')) ?>';
            try {
                const r = await fetch('<?= $escaper->escapeJs($sectionLoadUrl) ?>?sections=messages&force_new_section_timestamp=true&_=' + Date.now(), { headers: { 'X-Requested-With': 'XMLHttpRequest' }, credentials: 'same-origin' });
                const data = await r.json();
                const list = (data && data.messages && data.messages.messages) || [];
                const err = list.find(m => m.type === 'error') || list[0];
                if (!err || !err.text) return fallback;
                const text = new DOMParser().parseFromString(String(err.text), 'text/html').body.textContent;
                return text || fallback;
            } catch (e) {
                return fallback;
            }
        }
    };
}
</script>

